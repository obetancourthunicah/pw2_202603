<div data-role="card" class="card">
    <div data-role="card-header" class="card-header">
        <img src="{{card_img_url}}" alt="{{card_img_alt}}" />
    </div>
    <div data-role="card-body" class="{{card_body_class}}">
        <h3>{{card_title}}</h3>
        <p>{{card_detail}}</p>
        <em>L{{card_price}}</em>
    </div>
    <div data-role="card-footer" class="{{card_body_class}}">
        <a href="#addToCart">Subscribirse</a>
    </div>
</div>